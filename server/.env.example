# Owner: Archit (frozen; ask before changing) | Server config. Copy to server/.env and fill in.
#   PowerShell: Copy-Item server\.env.example server\.env

PORT=4000
RPC_URL=http://127.0.0.1:8545

# Hardhat account #0 private key: `npm run chain` prints it as "Account #0". Local test key only.
PUBLISHER_PRIVATE_KEY=

# Free key from Google AI Studio. Required while AI_MODE=gemini.
GEMINI_API_KEY=

# Optional: Gemini model for metadata suggestions (read by aiMetadata.js). Default gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# gemini | off  (off forces the regex/keyword fallback)
AI_MODE=gemini
